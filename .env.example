# Copiá este archivo a .env.local y completá los valores.
# Con Supabase local, `pnpm supabase status` te muestra la URL y la anon key.
#
# Solo van claves PÚBLICAS: la anon key está pensada para el navegador y la
# seguridad real la dan las políticas RLS. La service_role key NUNCA va acá.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio (ej. https://fulb05.vercel.app). Se usa como
# metadataBase para que las imágenes Open Graph tengan URL absoluta.
NEXT_PUBLIC_SITE_URL=

# Buscador de canchas de Google Maps (opcional: sin key, el formulario pide
# pegar el enlace). Es pública por diseño; la protegen las restricciones de la
# key en Google Cloud (referrers + APIs) y las cuotas diarias.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
